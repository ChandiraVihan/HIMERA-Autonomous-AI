if(NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "Simulator executable missing: ${PROGRAM}")
endif()
# The simulator writes one initial JSON response and then one per command.
set(INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/sim-smoke-input.txt")
file(WRITE "${INPUT_FILE}" "GUNSHOT\nSPOT\nDOOR\nSTEP\nSAFE 1\nSET health 0.2\nPLAYER 15 8\nRESET\n")
execute_process(COMMAND "${PROGRAM}" INPUT_FILE "${INPUT_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Simulator exited ${result}: ${err}")
endif()
string(REGEX MATCHALL "\"ok\":true" success "${out}")
list(LENGTH success count)
if(NOT count EQUAL 9)
    message(FATAL_ERROR "Expected 9 JSON responses, got ${count}: ${out}")
endif()
string(FIND "${out}" "D* Lite repaired" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Door event did not repair D* Lite graph")
endif()
